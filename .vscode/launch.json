{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Web proxy (dev)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/web/main.py",
      "args": ["--dev", "--config=${workspaceFolder}/src/web/config.template.ini"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/src/web"
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Unit Tests",
      "program": "${workspaceFolder}/tests/index.js",
      "args": ["${workspaceFolder}/build/test/web"],
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
